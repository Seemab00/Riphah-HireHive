digraph ERD {
  graph [rankdir=LR, bgcolor="#F6F8FA", fontname="Helvetica", nodesep=0.6, ranksep=1.3, pad=0.4, label="Riphah HireHive: data model (ERD)\nPrototype: each table is a list saved in the browser (localStorage). PK = primary key, FK = foreign key.", labelloc=t, fontsize=18];
  node  [shape=plain, fontname="Helvetica", fontsize=12];
  edge  [fontname="Helvetica", fontsize=11, color="#0B5C6B", dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.6];

  Account [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0B5C6B" BGCOLOR="white">
      <TR><TD BGCOLOR="#0B5C6B" ALIGN="LEFT"><FONT COLOR="white"><B>Account</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> email</TD></TR>
      <TR><TD ALIGN="LEFT">name, password, role</TD></TR>
      <TR><TD ALIGN="LEFT">sapId, program (students, volunteers)</TD></TR>
      <TR><TD ALIGN="LEFT">volunteerStatus, volunteerStage,</TD></TR>
      <TR><TD ALIGN="LEFT">volunteerStageDecisions, placement, shift</TD></TR>
      <TR><TD ALIGN="LEFT">cvName, cvVisible</TD></TR>
      <TR><TD ALIGN="LEFT">coordinatorLevel, department, phase</TD></TR>
      <TR><TD ALIGN="LEFT">company, gradYear, linkedinUrl,</TD></TR>
      <TR><TD ALIGN="LEFT">availability (alumni)</TD></TR>
    </TABLE>>];

  Team [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0B5C6B" BGCOLOR="white">
      <TR><TD BGCOLOR="#0B5C6B" ALIGN="LEFT"><FONT COLOR="white"><B>Team</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> ownerEmail</TD></TR>
      <TR><TD ALIGN="LEFT">title, program, technology</TD></TR>
      <TR><TD ALIGN="LEFT">supervisor, members, sapIds</TD></TR>
      <TR><TD ALIGN="LEFT">status, templateStatuses</TD></TR>
    </TABLE>>];

  LcdRequest [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0B5C6B" BGCOLOR="white">
      <TR><TD BGCOLOR="#0B5C6B" ALIGN="LEFT"><FONT COLOR="white"><B>LcdRequest</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> teamId</TD></TR>
      <TR><TD ALIGN="LEFT">teamTitle, reason, status</TD></TR>
      <TR><TD ALIGN="LEFT">issued, returned</TD></TR>
    </TABLE>>];

  MockInterview [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#F2A900" BGCOLOR="white">
      <TR><TD BGCOLOR="#F2A900" ALIGN="LEFT"><B>MockInterview</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> teamId</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> alumniEmail</TD></TR>
      <TR><TD ALIGN="LEFT">slot, meetingLink, status</TD></TR>
      <TR><TD ALIGN="LEFT">score, recommendation, comment</TD></TR>
    </TABLE>>];

  Feedback [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0B5C6B" BGCOLOR="white">
      <TR><TD BGCOLOR="#0B5C6B" ALIGN="LEFT"><FONT COLOR="white"><B>Feedback</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> alumniEmail</TD></TR>
      <TR><TD ALIGN="LEFT">alumniName, rating, comment, date</TD></TR>
    </TABLE>>];

  Interest [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0B5C6B" BGCOLOR="white">
      <TR><TD BGCOLOR="#0B5C6B" ALIGN="LEFT"><FONT COLOR="white"><B>Interest</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> company (Account email)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B> teamId</TD></TR>
    </TABLE>>];

  Account -> Team          [label="registers (FYP student)"];
  Team -> LcdRequest       [label="requests"];
  Team -> MockInterview    [label="is interviewed in"];
  Account -> MockInterview [label="interviews (alumnus)"];
  Account -> Feedback      [label="writes (alumnus)"];
  Account -> Interest      [label="shows interest (company)"];
  Team -> Interest         [label="is liked by"];
}
